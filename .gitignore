.DS_Store
*.swp

# Personal content (repo is public / forkable — see README "Setting this up
# for yourself"). Folders stay tracked via a template or .gitkeep; fill them
# in with your own facts, docs, and projects.
knowledge/me/*
!knowledge/me/.gitkeep

knowledge/audience/*
!knowledge/audience/.gitkeep

knowledge/library/*
!knowledge/library/GUIDE.md

projects/*
!projects/_TEMPLATE.md

# Claude Code worktree scratch dirs
.claude/worktrees/

# Obsidian vault config (local-only)
.obsidian/


# Design reference images live in raw/ until a clustering session files them.
# They are third-party work (Dribbble etc.) and this repo is PUBLIC — never publish them.
knowledge/raw/**/*.png
knowledge/raw/**/*.jpg
knowledge/raw/**/*.jpeg
knowledge/raw/**/*.gif
knowledge/raw/**/*.webp
knowledge/raw/**/*.mp4

# leads skill: entirely private (sales lead data/logic), not for the public repo
skills/leads/
__pycache__/
